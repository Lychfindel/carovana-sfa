# Copia questo file in .env e modifica i valori.

# Password della pagina di gestione (obbligatorio cambiarla)
ADMIN_PASSWORD=cambiami

# Porta su 127.0.0.1 a cui il reverse proxy inoltra le richieste
CAROVANA_PORT=8000

# Slogan mostrato nel menu e nella home (vuoto = "Per vivere non per speculare")
SLOGAN=

# Indirizzo pubblico del sito, usato nei link delle email (es. https://carovana.example.org)
SITE_URL=

# --- Email (lascia vuoto SMTP_HOST per non inviare email) ---
# Server SMTP: di solito porta 587 con STARTTLS, oppure 465 con SSL
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Mittente delle email, es.: Carovana SFA <carovana@example.org>
MAIL_FROM=
# Chi riceve gli avvisi di nuove proposte e contributi (più indirizzi separati da virgola)
ADMIN_EMAIL=
