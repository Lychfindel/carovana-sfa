# Copia questo file in .env e modifica i valori.

# Password della pagina di gestione (obbligatorio cambiarla)
ADMIN_PASSWORD=cambiami

# Indirizzo della pagina di gestione: https://tuosito/<ADMIN_PATH>
ADMIN_PATH=gestione

# Chiave per le sessioni: genera con  python3 -c "import secrets; print(secrets.token_hex(32))"
# Se vuota viene generata e salvata in data/.secret_key
SECRET_KEY=

# Metti 1 se il sito è servito in HTTPS (cookie di sessione solo su connessioni sicure)
COOKIE_SECURE=1

# Porta su 127.0.0.1 a cui il reverse proxy inoltra le richieste
CAROVANA_PORT=8000
