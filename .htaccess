Options -Indexes
DirectoryIndex index.php

# Blocca file che non devono essere scaricabili
<FilesMatch "(^\.|^config\.php$|\.(md|csv|tmp|lock|py|txt)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Limiti per le foto dei contributi (solo Apache con mod_php; con PHP-FPM vale .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 64M
  php_value max_file_uploads 20
  php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 64M
  php_value max_file_uploads 20
  php_value memory_limit 256M
</IfModule>
