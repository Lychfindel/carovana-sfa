Options -Indexes
DirectoryIndex index.php

# Blocca file che non devono essere scaricabili
<FilesMatch "(^\.|^config\.php$|\.(md|csv|tmp|lock|py|txt)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
